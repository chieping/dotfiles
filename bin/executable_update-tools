#!/usr/bin/env bash
# 日々更新したいツールをまとめて更新する
set -uo pipefail

failed=()
step() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }
run() { "$@" || failed+=("$*"); }

step "Homebrew: herdr, crit, pup"
run brew update --quiet
run brew upgrade herdr crit pup

step "herdr plugin: annotate"
run herdr plugin install plannotator/herdr-annotate --yes
# plannotator-tui のダウンロード失敗は install 成功扱いになり、annotate.open / last が黙って動かなくなる
ensure_plannotator_tui() {
  local root
  root="$(jq -r '.[] | select(.plugin_id == "annotate") | .plugin_root' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins.json")" || return 1
  for _ in 1 2 3; do
    [ -x "$root/bin/plannotator-tui.exe" ] && return 0
    echo "plannotator-tui が見つからないので再取得します"
    bash "$root/scripts/fetch-plannotator-tui.sh"
  done
  [ -x "$root/bin/plannotator-tui.exe" ]
}
run ensure_plannotator_tui

step "Claude Code"
run claude update

step "Claude Code plugins"
run claude plugin marketplace update
for id in $(claude plugin list --json | jq -r '.[].id'); do
  run claude plugin update "$id"
done

step "Agent skills (npx skills)"
run npx -y skills update --global --yes

step "Datadog skills (pup)"
run pup --no-agent skills install claude-code --type skill --yes -o table

step "gh extensions"
run gh extension upgrade --all

if ((${#failed[@]})); then
  printf '\n\033[1;31m失敗:\033[0m\n'
  printf '  %s\n' "${failed[@]}"
  exit 1
fi
printf '\n\033[1;32m完了\033[0m (herdr は再起動、Claude Code はセッション再起動で反映)\n'
